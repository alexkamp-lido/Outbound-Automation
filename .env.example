# Origami sequencer (https://origami.chat)
ORIGAMI_API_KEY=og_live_...

# ── ONE of the following three (in priority order) ──

# BEST: workspace ID → enumerates every campaign automatically.
ORIGAMI_WORKSPACE_ID=

# RECOMMENDED: bootstrap campaign ID → any single campaign id from your dashboard.
# On the first run the client fetches this campaign, reads workspaceId out of the
# response, then enumerates the entire workspace. You never touch this again as new
# campaigns are added — they show up automatically.
ORIGAMI_BOOTSTRAP_CAMPAIGN_ID=

# FALLBACK: comma-separated list of campaign IDs. Manual — new campaigns must be
# added here by hand. Only use if the two options above aren't practical.
ORIGAMI_CAMPAIGN_IDS=

# Slack incoming webhook that the reviewer digest posts to.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Shared secret gate on POST /reviewer/run — the Origami scheduled agent must include
# ?secret=... matching this value. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
REVIEWER_SHARED_SECRET=

# How many hours back to consider "today's replies" (default 36).
REVIEWER_LOOKBACK_HOURS=36
