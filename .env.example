# Origami sequencer (https://origami.chat)
ORIGAMI_API_KEY=og_live_...

# By default the reviewer enumerates every workspace on your account and every
# campaign in each — new workspaces and campaigns are picked up automatically.
# The two variables below are optional narrowing overrides.

# OPTIONAL: single workspace ID. Set to restrict the reviewer to one workspace.
ORIGAMI_WORKSPACE_ID=

# OPTIONAL: comma-separated list of specific campaign IDs. Manual pin — new
# campaigns must be added here by hand.
ORIGAMI_CAMPAIGN_IDS=

# Slack incoming webhook that the reviewer digest posts to.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Shared secret gate on POST /reviewer/run — the Origami scheduled agent must include
# ?secret=... matching this value. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
REVIEWER_SHARED_SECRET=

# How many hours back to consider "today's replies" (default 36).
REVIEWER_LOOKBACK_HOURS=36

# Origami webhook signing secret. Copy from Origami dashboard → Settings → Developers →
# Webhooks → the reveal-once modal after creating the endpoint. Starts with `whsec_`.
# Without this, POST /webhooks/origami returns 500.
ORIGAMI_WEBHOOK_SECRET=

# Filesystem path where the reply-event SQLite DB lives. Local: ./data (auto-created).
# On Railway: /data with a persistent volume mounted there — otherwise the DB is lost
# on every redeploy.
DATA_DIR=./data

# Plusvibe reply relay via Slack Events API.
# Signing secret from your Slack app (api.slack.com/apps → Basic Information →
# App Credentials → Signing Secret). Without it, POST /webhooks/plusvibe returns 500.
PLUSVIBE_SLACK_SIGNING_SECRET=
