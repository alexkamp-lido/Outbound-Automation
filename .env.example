# Origami sequencer (https://origami.chat)
ORIGAMI_API_KEY=og_live_...

# Comma-separated list of campaign IDs to review.
# Required because Origami's v2 list endpoints all need a scope (workspace/table/campaign)
# and this account doesn't have a workspace ID exposed. Populate with the campaign IDs
# you want the reviewer to watch — new campaigns must be added here manually.
ORIGAMI_CAMPAIGN_IDS=cmp_xxx,cmp_yyy

# Optional: if you have a workspace ID, the client will use that instead and enumerate
# every campaign automatically. Leave empty otherwise.
ORIGAMI_WORKSPACE_ID=

# Slack incoming webhook that the reviewer digest posts to.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Shared secret gate on POST /reviewer/run — the Origami scheduled agent must include
# ?secret=... matching this value. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
REVIEWER_SHARED_SECRET=

# How many hours back to consider "today's replies" (default 36).
REVIEWER_LOOKBACK_HOURS=36
